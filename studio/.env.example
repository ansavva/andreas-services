# Copy this file to `studio/.env` and fill in your real value.
# `.env` is git-ignored; `.env.example` is committed as a template.
#
# This file is for the LOCAL half of studio — the generation skills under
# .claude/skills/ that run inside Claude on your machine. The deployed half
# (backend/, frontend/) takes its configuration from Terraform and the deploy
# workflow, never from here.

# AWS access is NOT a key in this file. The media bucket
# (xharness-prod-media-us-east-1) is reached with your AWS login: sign in per
# session with `aws login`, and the skills bridge those credentials to boto3
# via `aws configure export-credentials`. See docs/PIPELINE.md.

# Replicate API token — REQUIRED for the whole studio-* workflow. Every engine
# runs on Replicate: bytedance/seedance-2.0 (studio-seedance),
# kwaivgi/kling-v3-omni-video (studio-kling), and the image models
# google/nano-banana-pro | nano-banana-2 and openai/gpt-image-2 | gpt-image-1.5
# (studio-image).
#
# Assets are NEVER uploaded to Replicate: everything sent to a model must
# already be an S3 object and reaches Replicate only as a short-lived presigned
# URL. Upload a local file to S3 first (the `studio-s3` skill), then reference its key.
# Create a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_token_here

# ---------------------------------------------------------------------------
# Optional overrides. The defaults are correct; these exist as the seam for
# pointing the skills at a different bucket or a staged copy of the tree.
#
# The XHARNESS_ prefix and the bucket name are grandfathered from when this
# pipeline lived in its own repo. They will be renamed together in a later
# pass — until then, do not rename one without the other.
# ---------------------------------------------------------------------------
# XHARNESS_S3_BUCKET=xharness-prod-media-us-east-1
# XHARNESS_S3_PREFIX=

# Kling AI API 2.0 — OPTIONAL direct-API path for studio-kling. The default
# Kling path runs kwaivgi/kling-v3-omni-video on Replicate and needs only
# REPLICATE_API_TOKEN above; this key is for a deliberately purchased package.
# Create at https://kling.ai/dev/api-key (shown ONCE).
