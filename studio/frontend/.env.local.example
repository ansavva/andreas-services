# Copy to .env.local for local development. In prod these are set by the deploy
# workflow from the Terraform outputs it reads back out of SSM.

# The API. Point at the local dev server, or at studio-api.andreas.services.
VITE_API_URL=http://localhost:8000

VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# The Cognito Managed Login host the app redirects to for sign-in — a bare
# hostname, no scheme and no trailing slash. A dev stack's is
# `studio-dev-<short12>.auth.us-east-1.amazoncognito.com`; prod's is
# `studio-auth.andreas.services`. `dev-setup.sh` fills this in from the stack's
# Terraform output; there is no in-app sign-in form to fall back on without it.
VITE_COGNITO_DOMAIN=
