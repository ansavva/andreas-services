{
 "i2v-sampled": {
  "manifest": {
   "base": "i2v",
   "dataset": [
    {
     "caption": "ohwx_sa, grey t-shirt",
     "name": "a.png",
     "url": "https://bucket.test/a.png?x"
    },
    {
     "caption": "ohwx_sa",
     "name": "b.png",
     "url": "https://bucket.test/b.png?x"
    }
   ],
   "lr": 0.0001,
   "rank": 32,
   "resolution": 768,
   "sample_prompts": [
    "ohwx_sa, cooking in a bright kitchen, medium shot",
    "ohwx_sa, sitting on a beach at sunset, full body"
   ],
   "sample_seed": 42,
   "sample_steps": 20,
   "save_every": 250,
   "stem": "subject-a-ohwx-sa-1234",
   "steps": 1000,
   "trigger": "ohwx_sa"
  },
  "process": {
   "datasets": [
    {
     "caption_dropout_rate": 0.05,
     "caption_ext": "txt",
     "folder_path": "/workspace/dataset",
     "num_frames": 1,
     "resolution": [
      768
     ]
    }
   ],
   "device": "cuda:0",
   "model": {
    "arch": "wan22_14b_i2v",
    "low_vram": false,
    "model_kwargs": {
     "train_high_noise": true,
     "train_low_noise": true
    },
    "name_or_path": "Wan-AI/Wan2.2-I2V-A14B-Diffusers",
    "quantize": false
   },
   "network": {
    "linear": 32,
    "linear_alpha": 32,
    "split_multistage_loras": true,
    "type": "lora"
   },
   "sample": {
    "format": "jpg",
    "height": 768,
    "neg": "",
    "num_frames": 1,
    "prompts": [
     "ohwx_sa, cooking in a bright kitchen, medium shot --ctrl_img /workspace/dataset/a.png",
     "ohwx_sa, sitting on a beach at sunset, full body --ctrl_img /workspace/dataset/b.png"
    ],
    "sample_every": 250,
    "sample_start_step": 0,
    "sample_steps": 20,
    "sampler": "flowmatch",
    "seed": 42,
    "walk_seed": false,
    "width": 768
   },
   "save": {
    "dtype": "float16",
    "max_step_saves_to_keep": 100,
    "save_every": 250
   },
   "train": {
    "batch_size": 1,
    "cache_text_embeddings": true,
    "disable_sampling": false,
    "dtype": "bf16",
    "gradient_accumulation": 1,
    "gradient_checkpointing": true,
    "lr": 0.0001,
    "noise_scheduler": "flowmatch",
    "optimizer": "adamw8bit",
    "optimizer_params": {
     "weight_decay": 0.0001
    },
    "skip_first_sample": true,
    "steps": 1000,
    "switch_boundary_every": 10,
    "timestep_type": "linear",
    "train_text_encoder": false,
    "train_unet": true
   },
   "training_folder": "/workspace/output",
   "type": "sd_trainer"
  }
 },
