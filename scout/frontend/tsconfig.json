{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    // Browser code, so no ambient Node globals — `@types/node` exists here only
    // for vite.config.ts, which `tsconfig.node.json` checks separately. Without
    // this, `process.env` in a component would typecheck and then be undefined
    // at runtime.
    "types": ["vite/client"]
  },
  // No `references`: a referenced project has to be composite and composite
  // projects may not disable emit (TS6306/TS6310), so `tsc -b` here would write
  // vite.config.js next to the source. `npm run typecheck` checks both projects
  // with two plain, non-emitting invocations instead.
  "include": ["src"]
}
