#!/usr/bin/env bash
# pre-commit hook — runs scout unit tests + frontend lint when scout/ files are staged.
# Install: scout/scripts/install-hooks.sh
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)

if ! git diff --cached --name-only | grep -q '^scout/'; then
    exit 0
fi

# Git hooks run in non-interactive shells; poetry may not be on PATH.
export PATH="$(python3 -m site --user-base)/bin:$PATH"

echo "Scout files staged — running unit tests and lint..."

(
    cd "${REPO_ROOT}/scout/backend/events-api"
    poetry install --with dev --no-root --no-interaction --no-ansi -q
    poetry run pytest tests/ -v
) || { echo "FAIL: events-api unit tests"; exit 1; }

(
    cd "${REPO_ROOT}/scout/backend/email-processor"
    poetry install --with dev --no-root --no-interaction --no-ansi -q
    poetry run pytest tests/ -v
) || { echo "FAIL: email-processor unit tests"; exit 1; }

(
    cd "${REPO_ROOT}/scout/frontend"
    [[ ! -d node_modules ]] && npm install --silent
    npm run lint
) || { echo "FAIL: frontend lint"; exit 1; }

echo "Scout pre-commit checks passed."

# ---------------------------------------------------------------------------
# tflint — run on any staged infra files
# ---------------------------------------------------------------------------
if ! git diff --cached --name-only | grep -q 'infra/'; then
    exit 0
fi

if ! command -v tflint &>/dev/null; then
    echo "WARNING: tflint not installed — skipping infra lint (brew install tflint)"
    exit 0
fi

echo "Infra files staged — running tflint..."

for SERVICE in humbugg scout storybook; do
    if git diff --cached --name-only | grep -q "^${SERVICE}/infra/"; then
        tflint --recursive --chdir="${REPO_ROOT}/${SERVICE}/infra" \
            --config "${REPO_ROOT}/.tflint.hcl" \
            || { echo "FAIL: tflint ${SERVICE}"; exit 1; }
    fi
done

echo "tflint passed."
