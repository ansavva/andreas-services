{
  "permissions": {
    "allow": [
      "Bash(uv run*)",
      "Bash(studio *)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(aws configure export-credentials*)",
      "Bash(aws s3 ls*)",
      "Bash(which ffmpeg)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-push-to-main.sh"
          }
        ]
      }
    ]
  }
}
