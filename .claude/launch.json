{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "unset PORT; exec ./studio/scripts/dev-up.sh"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "studio-5178",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "unset PORT; STUDIO_DEV_PORT=5178 exec ./studio/scripts/dev-up.sh"
      ],
      "port": 5178,
      "autoPort": false
    },
    {
      "name": "classroom",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "unset PORT; exec ./classroom/scripts/dev-up.sh"
      ],
      "port": 5174,
      "autoPort": false
    },
    {
      "name": "website",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "export PATH=/opt/homebrew/opt/node@20/bin:$PATH && exec npm --prefix website/frontend run dev"
      ],
      "port": 5175,
      "autoPort": false
    },
    {
      "name": "website-backend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd website/backend && exec poetry run python -m website_core.handlers.local.api.api_dev_server"
      ],
      "port": 8002,
      "autoPort": false
    },
    {
      "name": "website-prod",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "export PATH=/opt/homebrew/opt/node@20/bin:$PATH && cd website/frontend && exec npm run start"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "humbugg-backend",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "exec ./humbugg/scripts/dev-up-backend.sh"
      ],
      "port": 5001,
      "autoPort": false
    },
    {
      "name": "humbugg-marketing",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "unset PORT; exec ./humbugg/scripts/dev-up-marketing.sh"
      ],
      "port": 5176,
      "autoPort": false
    },
    {
      "name": "humbugg-app",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "exec ./humbugg/scripts/dev-up-app.sh --web"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "humbugg-app-stubbed",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "cd humbugg/app && EXPO_PUBLIC_API_BASE_URL=/api EXPO_PUBLIC_COGNITO_CLIENT_ID=e2e-fake-client EXPO_PUBLIC_COGNITO_DOMAIN=e2e-fake.auth.us-east-1.amazoncognito.com npx expo export -p web --output-dir dist-e2e --clear && exec npx serve -s dist-e2e -l 4174 --no-clipboard"
      ],
      "port": 4174,
      "autoPort": false
    },
    {
      "name": "storybook-backend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd storybook/backend && exec poetry run python -m storybook_core.handlers.local.api.api_dev_server"
      ],
      "port": 8003,
      "autoPort": false
    },
    {
      "name": "storybook-frontend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "exec npm --prefix storybook/frontend/storybook-ui run dev"
      ],
      "port": 5177,
      "autoPort": false
    }
  ]
}
