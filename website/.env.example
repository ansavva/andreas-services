# Copy to .env for local development. Real secrets are set on the Lambdas by the
# deploy workflow (never committed).

# --- Frontend (SSR Lambda) runtime ---
# Backend API base URL, including the /api suffix.
WEBSITE_API_URL=https://website-api.andreas.services/api
# Cognito (admin login + token verification)
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret used to sign the admin session cookie
SESSION_SECRET=change-me

# --- Frontend build-time (VITE_, baked into the client bundle) ---
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_CAL_LINK=andreas/intro

# --- Backend (Python API Lambda) runtime ---
WEBSITE_INTAKE_TABLE=website-prod-intake
WEBSITE_ALLOWED_ORIGIN=https://www.andreas.services
# Kit v4 API key (Settings → Developer → API Keys; starts with kit_). The
# adapter uses the v4 API — a legacy v3 key 401s.
KIT_API_KEY=
KIT_FORM_ID=

# --- Admin bootstrap (scripts/create-admin-user.sh) ---
ADMIN_EMAIL=asavva1991@gmail.com
ADMIN_PASSWORD=change-me

AWS_REGION=us-east-1
