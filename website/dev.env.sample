# Website local development — the one file, and this is what it looks like.
# Real file: ~/.config/andreas-services/website/dev.env (or $WEBSITE_DEV_ENV_FILE).
# Not committed; outside the repo so it survives git clean, is shared by every
# worktree on the machine, and holds secrets where no `git add -f` reaches them.
#
# The website has no per-machine AWS stack, so nothing generates this: scripts/
# dev-up.sh lays it out from this sample on every run — your values kept.
# dev-up.sh exports every key into the API, the SSR server and Vite; Vite
# inlines only VITE_*. Real secrets for prod are set on the Lambdas by the
# deploy workflow, never here.

# ---- frontend (SSR Lambda) runtime ------------------------------------------

# The API, including the /api suffix. Local backend: http://localhost:8002/api
WEBSITE_API_URL=http://localhost:8002/api
# Cognito hosted sign-in + token verification. The client is confidential, so
# the secret lives only here and on the SSR Lambda.
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=website-auth.andreas.services
COGNITO_CLIENT_SECRET=change-me
# Public origin, used to build OAuth redirect URIs (exact-match at Cognito).
# Unset locally — it falls back to http://localhost:5175.
#PUBLIC_ORIGIN=https://www.andreas.services
# Signs the admin session cookie. `openssl rand -base64 32`.
SESSION_SECRET=change-me

# ---- frontend build-time (VITE_, baked into the client bundle) ---------------

VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_CAL_LINK=andreas/intro

# ---- backend (Python API) runtime -------------------------------------------

WEBSITE_INTAKE_TABLE=website-prod-intake
WEBSITE_ALLOWED_ORIGIN=http://localhost:5175
# Kit v4 API key (Settings → Developer → API Keys; starts with kit_). The
# adapter uses the v4 API — a legacy v3 key 401s.
KIT_API_KEY=
KIT_FORM_ID=

# ---- admin bootstrap (scripts/create-admin-user.sh, run from CI) ------------

# Prefixed, matching the GitHub secrets of the same names. The bare
# ADMIN_EMAIL / ADMIN_PASSWORD still work and are read second.
#WEBSITE_ADMIN_EMAIL=you@example.com
#WEBSITE_ADMIN_PASSWORD=change-me

AWS_REGION=us-east-1
