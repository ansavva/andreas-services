# Storybook local development — the one file, and this is what it looks like.
# Real file: ~/.config/andreas-services/storybook/dev.env (or $STORYBOOK_DEV_ENV_FILE).
# Not committed; outside the repo so it survives git clean, is shared by every
# worktree on the machine, and holds tokens where no `git add -f` reaches them.
#
# Storybook has no per-machine AWS stack, so nothing generates this: scripts/
# dev-up.sh lays it out from this sample on every run — your values kept.
# dev-up.sh exports every key into the API and Vite; Vite inlines only VITE_*.
# Prod values are set on the Lambdas by the deploy workflow, never here.

# ---- frontend (Vite, baked into the client bundle) ---------------------------

VITE_API_URL=http://localhost:8003
# From `terraform output` on a dev apply of storybook/infra.
VITE_AWS_COGNITO_USER_POOL_ID=us-east-1_example
VITE_AWS_COGNITO_APP_CLIENT_ID=example
VITE_AWS_COGNITO_DOMAIN=example.auth.us-east-1.amazoncognito.com

# ---- backend (Flask API) runtime --------------------------------------------

# DynamoDB Local; api_dev_server defaults these and creates the storybook-*
# tables on startup. The table-name keys stay unset locally on purpose — a
# local default that looks like a prod resource is one unset endpoint away
# from reading it.
#DYNAMODB_ENDPOINT_URL=http://localhost:8004
AWS_COGNITO_USER_POOL_ID=us-east-1_example
AWS_COGNITO_APP_CLIENT_ID=example
APP_URL=http://localhost:5177
S3_BUCKET_NAME=
LOG_LEVEL=INFO

# Provider tokens.
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
STABILITY_API_KEY=

# The image-normalization worker (dev-up.sh --worker) polls this queue.
#IMAGE_UPLOAD_QUEUE_URL=
