# Classroom local development — the one file, and this is what it looks like.
# Real file: ~/.config/andreas-services/classroom/dev.env (or $CLASSROOM_DEV_ENV_FILE).
# Not committed; outside the repo so it survives git clean and is shared by
# every worktree on the machine. dev-setup.sh writes the generated section from
# this machine's dev stack; dev-up.sh exports only VITE_* before Vite starts;
# dev-user.sh and dev-token.sh read the account.

# ---- generated (rewritten on every dev-setup.sh run; do not hand-edit) --------

# Frontend (Vite inlines VITE_*; dev-up.sh exports only this prefix). The DEV
# Cognito pool and its Managed Login host — local development never signs in
# against production. The app client registers http://localhost:5174.
VITE_API_URL=http://localhost:8001/api
VITE_COGNITO_DOMAIN=classroom-dev-000000000000.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=example

# ---- yours (kept as-is across reruns) -----------------------------------------

# Dev test account — dev-user.sh writes both; a reserved .test address belongs here.
CLASSROOM_DEV_USER_EMAIL=dev@classroom.test
CLASSROOM_DEV_USER_PASSWORD=
