# Illustrative only. `classroom/scripts/dev-setup.sh` WRITES .env.local from
# this machine's dev stack, so copying this file by hand is the slow path and
# leaves two of the three values wrong.
#
# The domain and client id below are per-machine — a Cognito pool named
# `classroom-dev-<short12>`, created by `classroom/scripts/dev-aws-setup.sh`.
# There is no shared dev pool to point at.
VITE_API_URL=http://localhost:8001/api
VITE_COGNITO_DOMAIN=classroom-dev-000000000000.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=replace-me
