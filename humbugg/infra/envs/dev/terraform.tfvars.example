# Values are supplied by humbugg/scripts/dev-aws-setup.sh. Do not create or
# commit a real tfvars file; the machine UUID belongs in the user's config home.
aws_region        = "us-east-1"
aws_account_id    = "123456789012"
aws_principal_arn = "arn:aws:iam::123456789012:user/example"
machine_id       = "00000000-0000-4000-8000-000000000000"
machine_short_id = "000000000000"
machine_name     = "developer-machine"
