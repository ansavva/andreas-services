aws_region = "us-east-1"

# Stripe test-mode credentials are NOT set here. They are injected via TF_VAR_* in
# CI from GitHub environment secrets/vars and must never be committed:
#   TF_VAR_stripe_publishable_key  <- vars.HUMBUGG_STRIPE_PUBLISHABLE_KEY (pk_test_...)
#   TF_VAR_stripe_secret_key       <- secrets.HUMBUGG_STRIPE_SECRET_KEY   (sk_test_...)
#   TF_VAR_stripe_webhook_secret   <- secrets.HUMBUGG_STRIPE_WEBHOOK_SECRET (whsec_...)
# See humbugg/docs/stripe-setup.md. Live-mode credentials are blocked (issue #159).
