{
  "name": "humbugg-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "export:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "e2e": "playwright test",
    "e2e:live": "E2E_LIVE=1 playwright test",
    "e2e:capture": "node e2e/support/capture-fixtures.mjs",
    "brand": "node tool/reconcile-cognito-branding.ts",
    "brand:check": "node tool/reconcile-cognito-branding.ts --check",
    "a11y:check": "node tool/accessibility-audit.ts"
  },
  "dependencies": {
    "@ansavva/design-system": "0.18.0",
    "@ansavva/tokens": "^0.6.0",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/lily-script-one": "^0.4.1",
    "@expo-google-fonts/spectral": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.12",
    "expo-auth-session": "~57.0.10",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react-native": "^13.2.0",
    "amazon-cognito-identity-js": "^6.3.12",
    "serve": "^14.2.4",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/e2e/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@ansavva/.*|standard-navigation)"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
