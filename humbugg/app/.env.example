# Build-time configuration for the Humbugg product app.
#
# Every value is inlined into the bundle at build time, so EXPO_PUBLIC_* is
# correct here: nothing below is a secret. Copy to `.env.local` for local dev —
# `humbugg/scripts/dev-aws-setup.sh` writes the real per-machine values.
#
# The SSR loader that used to supply the Cognito config on the web app has no
# equivalent here: a static export has no server, so configuration has to be
# baked in at build time.

# The API's own origin. Cross-origin now that the app is not same-origin with
# the API — production is https://api.humbugg.com.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5001/api

# Cognito Managed Login: the HOST of the hosted pages, no scheme and no path —
# `auth.humbugg.com` in production, `<prefix>.auth.<region>.amazoncognito.com`
# on a per-machine dev stack. Terraform outputs it as `cognito_auth_domain`.
#
# The user pool id and the AWS region used to live here too. Neither is read any
# more: sign-in talks to the hosted pages over OAuth endpoints derived from the
# domain, so the client id is the only pool identifier the app still needs.
EXPO_PUBLIC_COGNITO_DOMAIN=
EXPO_PUBLIC_COGNITO_CLIENT_ID=

# Marketing site origin, used for the legal links in the footer and the
# post-account-deletion landing page.
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:5173
