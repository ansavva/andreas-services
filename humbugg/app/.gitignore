# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects (managed workflow — `expo prebuild` output is not committed)
/ios
/android

# Dependencies
node_modules/

# Build-time env. `.env.example` is the committed template; the real values are
# per-machine (written by humbugg/scripts/dev-aws-setup.sh) or CI vars.
.env
.env.local
.env*.local

# Playwright — dist-e2e is the stubbed-mode export, .live-session.json holds a
# short-lived real dev-stack session minted by e2e/support/live-setup.mjs.
dist-e2e/
test-results/
playwright-report/
e2e/support/.live-session.json

# macOS
.DS_Store
