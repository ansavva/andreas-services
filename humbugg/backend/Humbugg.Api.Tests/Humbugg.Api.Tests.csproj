<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosts Program.cs in-process for the auth-pipeline tests. The dev-stack integration tier
         also uses it, but that tier is gated off in CI, and #656 is a bug CI has to catch. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!-- TestLambdaContext, so the real APIGatewayHttpApiV2ProxyFunction marshaller can be asked
         what principal API Gateway's authorizer claims produce. -->
    <PackageReference Include="Amazon.Lambda.TestUtilities" Version="4.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <!-- Coverage under Microsoft.Testing.Platform. The coverlet.collector this replaces
         was a VSTest datacollector — referenced for months, collecting nothing, because
         global.json runs these projects under MTP. Coverage is PRINTED AND GATES ON
         NOTHING: a threshold picked before anyone reads a real number either sits under
         it or fires on unrelated PRs until somebody deletes it. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Humbugg.Api/Humbugg.Api.csproj" />
  </ItemGroup>
</Project>
