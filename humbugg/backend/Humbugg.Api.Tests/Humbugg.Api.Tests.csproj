<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <!-- Coverage under Microsoft.Testing.Platform. The coverlet.collector this replaces
         was a VSTest datacollector — referenced for months, collecting nothing, because
         global.json runs these projects under MTP. Coverage is PRINTED AND GATES ON
         NOTHING: a threshold picked before anyone reads a real number either sits under
         it or fires on unrelated PRs until somebody deletes it. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Humbugg.Api/Humbugg.Api.csproj" />
  </ItemGroup>
</Project>
