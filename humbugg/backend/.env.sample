# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# CORS
CORS_ORIGIN=http://localhost:5173

# AWS Cognito
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=humbugg-web

# Local application
APP_BASE_URL=http://localhost:5173
DYNAMODB_ENDPOINT_URL=http://localhost:8001
HUMBUGG_PROFILES_TABLE=humbugg-profiles
HUMBUGG_GROUPS_TABLE=humbugg-groups
HUMBUGG_GROUPMEMBERS_TABLE=humbugg-groupmembers
HUMBUGG_DRAWS_TABLE=humbugg-draws
HUMBUGG_AUDIT_EVENTS_TABLE=humbugg-audit-events

# Plans and billing (Stripe IDs are optional until test-mode products exist)
HUMBUGG_FREE_PARTICIPANT_LIMIT=6
HUMBUGG_PLUS_PARTICIPANT_LIMIT=50
HUMBUGG_WORK_PARTICIPANT_LIMIT=10000
HUMBUGG_PLUS_PRICE_CENTS=1200
HUMBUGG_WORK_PRICE_CENTS=9900
HUMBUGG_PLUS_PRODUCT_ID=
HUMBUGG_PLUS_PRICE_ID=
HUMBUGG_WORK_PRODUCT_ID=
HUMBUGG_WORK_PRICE_ID=

# Stripe (TEST MODE ONLY). Live mode is blocked pending merchant-identity review (#159).
# Leave HUMBUGG_STRIPE_MODE=disabled to run without Stripe. To exercise billing locally,
# set it to "test" and provide test-mode credentials from `stripe listen` / the Stripe
# CLI — never a real/live key. See humbugg/docs/stripe-setup.md for the fixtures runbook.
HUMBUGG_STRIPE_MODE=disabled
# HUMBUGG_STRIPE_MODE=test
# HUMBUGG_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# HUMBUGG_STRIPE_SECRET_KEY=sk_test_xxx
# HUMBUGG_STRIPE_WEBHOOK_SECRET=whsec_xxx
